{
  "name": "have-a-sip",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",

    "test": "dotenv -e .env.test -- jest",
    "test:watch": "dotenv -e .env.test -- jest --watch",
    "test:studio": "dotenv -e .env.test -- prisma studio",
    "test:migrate": "dotenv -e .env.test -- prisma migrate deploy",

    "test:e2e": "playwright test",
    "test:e2e:local": "dotenv -e .env.e2e -- playwright test",

    "build:e2e": "next build",
    "build:e2e:local": "dotenv -e .env.e2e -- next build",

    "start:e2e": "next start",
    "start:e2e:local": "dotenv -e .env.e2e -- next start",

    "db:generate": "dotenv -e .env.test -- prisma generate",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "db:seed": "dotenv -e .env -- tsx prisma/seed.ts",

    "db:generate:e2e": "prisma generate",
    "db:generate:e2e:local": "dotenv -e .env.e2e -- prisma generate",

    "db:migrate:e2e": "prisma migrate deploy",
    "db:migrate:e2e:local": "dotenv -e .env.e2e -- prisma migrate deploy",

    "db:migrate:e2e:dev": "dotenv -e .env.e2e -- prisma migrate dev",

    "db:seed:e2e": "tsx prisma/seed.e2e.ts",
    "db:seed:e2e:local": "dotenv -e .env.e2e -- tsx prisma/seed.e2e.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tiptap/extension-color": "^3.29.0",
    "@tiptap/extension-font-family": "^3.29.0",
    "@tiptap/extension-image": "^3.29.0",
    "@tiptap/extension-link": "^3.29.0",
    "@tiptap/extension-placeholder": "^3.29.0",
    "@tiptap/extension-text-style": "^3.29.0",
    "@tiptap/extension-underline": "^3.29.0",
    "@tiptap/pm": "^3.29.0",
    "@tiptap/react": "^3.29.0",
    "@tiptap/starter-kit": "^3.29.0",
    "@vercel/blob": "^2.6.1",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.26.0",
    "next": "^16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "shadcn": "^4.15.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jest": "^30.4.2",
    "jest-environment-node": "^30.4.1",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
